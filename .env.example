# Address of the speaker. Everything else has a sensible default.
C10_HOST=192.168.1.100

# Override only if the speaker does not use the standard Linkplay ports.
# C10_HTTP_PORT=80
# C10_UPNP_PORT=49152

# Host folder mounted read-only into the container as /music.
C10_MUSIC_DIR=./music

# Extra container paths for more libraries, comma-separated.
# C10_LIBRARY_DIRS=/music,/more-music

# URL the speaker uses to fetch local files. Required with the default bridge
# network, because the container address is not reachable from the speaker.
# Example: http://192.168.1.135:8787
# C10_MEDIA_URL=

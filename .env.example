# Address of the speaker. Everything else has a sensible default.
C10_HOST=192.168.1.100

# Override only if the speaker does not use the standard Linkplay ports.
# C10_HTTP_PORT=80
# C10_UPNP_PORT=49152

# Host parent folder mounted read-only at /host/music for the folder browser.
# Set it to the folder that contains your music folders, for example /Volumes.
C10_MUSIC_ROOT=/Volumes

# No library is configured by default. Add subfolders in Speaker settings.
# Optional: preconfigure libraries inside the container.
# C10_LIBRARY_DIR=/host/music/music
# C10_LIBRARY_DIRS=/host/music/music,/host/music/other

# URL the speaker uses to fetch local files. Required with the default bridge
# network, because the container address is not reachable from the speaker.
# Example: http://192.168.1.135:8787
# C10_MEDIA_URL=
